<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- home.rohan.my: what the Mac runs and whether it's up. Installed by deploy.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>my.rohan.home</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/rohan/srv/rohan-home/bin/rohan-home</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/rohan/srv/rohan-home</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME_ADDR</key>
    <string>127.0.0.1:8080</string>
    <key>HOME_STATE</key>
    <string>/Users/rohan/srv/rohan-home/state.json</string>
    <key>HOME</key>
    <string>/Users/rohan</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/rohan/srv/rohan-home/logs/home.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/rohan/srv/rohan-home/logs/home.log</string>
</dict>
</plist>
